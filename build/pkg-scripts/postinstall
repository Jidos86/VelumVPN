#!/bin/sh

APP_NAME="VelumVPN"
CORRECT_PATH="/Applications/${APP_NAME}.app"
WRONG_PATH="/Applications/${APP_NAME}.localized/${APP_NAME}.app"

# --- Fix install path if installer created .localized directory ---
if [ -d "$WRONG_PATH" ] && [ ! -d "$CORRECT_PATH" ]; then
    mv "$WRONG_PATH" "$CORRECT_PATH"
    rm -rf "/Applications/${APP_NAME}.localized"
fi

# --- Set suid on mihomo binaries ---
chown root:admin "$CORRECT_PATH/Contents/Resources/sidecar/mihomo" || true
chown root:admin "$CORRECT_PATH/Contents/Resources/sidecar/mihomo-alpha" 2>/dev/null || true
chmod +s "$CORRECT_PATH/Contents/Resources/sidecar/mihomo" || true
chmod +s "$CORRECT_PATH/Contents/Resources/sidecar/mihomo-alpha" 2>/dev/null || true

exit 0
