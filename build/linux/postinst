#!/bin/bash

APP_NAME="VelumVPN"

# Kill running mihomo processes so they restart with new setuid on next launch
pkill -f "velumvpn-mihomo" 2>/dev/null || true
pkill -f "mihomo-alpha" 2>/dev/null || true

# Clean up old "sparkle" installation
if [ -L '/usr/bin/sparkle' ]; then
    if type update-alternatives 2>/dev/null >&1; then
        update-alternatives --remove 'sparkle' '/opt/sparkle/sparkle' 2>/dev/null || true
    fi
    rm -f '/usr/bin/sparkle'
fi

if type update-alternatives 2>/dev/null >&1; then
    # Remove previous link if it doesn't use update-alternatives
    if [ -L "/usr/bin/${APP_NAME}" -a -e "/usr/bin/${APP_NAME}" -a "$(readlink "/usr/bin/${APP_NAME}")" != "/etc/alternatives/${APP_NAME}" ]; then
        rm -f "/usr/bin/${APP_NAME}"
    fi
    update-alternatives --install "/usr/bin/${APP_NAME}" "${APP_NAME}" "/opt/${APP_NAME}/${APP_NAME}" 100 || ln -sf "/opt/${APP_NAME}/${APP_NAME}" "/usr/bin/${APP_NAME}"
else
    ln -sf "/opt/${APP_NAME}/${APP_NAME}" "/usr/bin/${APP_NAME}"
fi

chmod 4755 "/opt/${APP_NAME}/chrome-sandbox" 2>/dev/null || true
chmod +sx "/opt/${APP_NAME}/resources/sidecar/mihomo" || true
chmod +sx "/opt/${APP_NAME}/resources/sidecar/mihomo-alpha" 2>/dev/null || true

if hash update-mime-database 2>/dev/null; then
    update-mime-database /usr/share/mime || true
fi

if hash update-desktop-database 2>/dev/null; then
    update-desktop-database /usr/share/applications || true
fi

# Install icon to hicolor theme so it shows in app launchers and taskbars
for dir in 16x16 24x24 32x32 48x48 64x64 128x128 256x256 512x512 1024x1024; do
    src="/opt/${APP_NAME}/resources/icons/$dir.png"
    if [ -f "$src" ]; then
        install -Dm644 "$src" "/usr/share/icons/hicolor/$dir/apps/velumvpn.png"
    fi
done

if hash gtk-update-icon-cache 2>/dev/null; then
    gtk-update-icon-cache -q -t /usr/share/icons/hicolor || true
fi
